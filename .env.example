# Base de Datos SQL (PostgreSQL en Railway / SQLite en local)
# En Railway: se inyecta automáticamente al agregar el plugin 'PostgreSQL' al proyecto.
# En local: si no se especifica, usa automáticamente SQLite (newsletter.db).
DATABASE_URL=postgresql://postgres:password@host:port/railway

# Anthropic (Claude) API Key (requerido para generar newsletters con Claude Sonnet 4.6)
ANTHROPIC_API_KEY=sk-ant-...

# Configuración de WhatsApp API
# Opción 1: Evolution API (Recomendado para Railway / producción, basado en Baileys, ligero)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu-global-api-key
EVOLUTION_INSTANCE=govlab

# Opción 2: Open-Wa (Puppeteer REST)
OPENWA_API_URL=http://localhost:8080
OPENWA_API_KEY=

# Resend API Key (legacy / opcional si se mantiene respaldo por correo)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
