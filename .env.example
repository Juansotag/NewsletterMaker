# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu-service-role-o-secret-key
# Opcional (si usas anon key en lugar de secret key):
# SUPABASE_ANON_KEY=tu-anon-key

# Anthropic Claude API Key (requerido para generar newsletters con IA)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Resend API Key (opcional, para envío de correos)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
