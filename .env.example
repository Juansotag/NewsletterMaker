# Configuración de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=tu-service-role-o-secret-key
# Opcional (si usas anon key en lugar de secret key):
# SUPABASE_ANON_KEY=tu-anon-key

# OpenAI API Key (requerido para generar newsletters con GPT-4o)
OPENAI_API_KEY=sk-proj-...

# Configuración de WhatsApp API
# Opción 1: Evolution API (Recomendado para Railway / producción, basado en Baileys, ligero)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=tu-global-api-key
EVOLUTION_INSTANCE=govlab

# Opción 2: Open-Wa (Puppeteer REST)
OPENWA_API_URL=http://localhost:8080
OPENWA_API_KEY=

# Resend API Key (legacy / opcional si se mantiene respaldo por correo)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=onboarding@resend.dev
